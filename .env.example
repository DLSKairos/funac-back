# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/funac_db

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro_minimo_32_caracteres_aqui

# Servidor
NODE_ENV=development
PORT=5000

# CORS
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Email (Resend HTTP API - https://resend.com/docs/api-reference/emails/send-email)
# Nota: se usa la API HTTP (no SMTP) porque Render bloquea/restringe los puertos
# SMTP salientes (465/587), lo que causaba ETIMEDOUT en produccion.
RESEND_API_KEY=tu_resend_api_key
EMAIL_FROM=FUNAC <notificaciones@funaac.org>
EMAIL_ADMIN=admin@funaac.org
# Recibe el resumen + hoja de vida de cada nueva postulacion de voluntariado.
VOLUNTEER_NOTIFICATION_EMAIL=gerencia@funaac.org
# Remitente (From) de los correos que se envian al postulante (ej: cambio de estado).
VOLUNTEER_FROM_EMAIL=noreply@funaac.org

# ePayco (solicitar credenciales a David)
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_TEST_MODE=true

# URL de la API (para webhooks)
API_URL=http://localhost:5000

# Almacenamiento
UPLOAD_DIR=uploads
